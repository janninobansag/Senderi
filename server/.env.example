# Local API configuration. This file contains placeholders only.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/senderi
# Optional: dedicated MongoDB test connection for profile image persistence checks.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/senderi
CLIENT_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0

# Configure these when the matching feature is implemented; never commit live values.
SESSION_SECRET=
CLOUDINARY_CLOUD_NAME=
# Comma-separated MongoDB user IDs permitted to use /api/admin.
ADMIN_USER_IDS=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Active transactional template; its reset link uses {{params.resetUrl}}.
BREVO_RESET_TEMPLATE_ID=
PUBLIC_APP_URL=http://localhost:5173
# Generate a key pair once with `npx web-push generate-vapid-keys` and set these in the API environment.
VAPID_SUBJECT=mailto:your-email@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
